<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">
  <article>
    <section class="page-hero article-hero">
      <div class="container">
        <a class="back-link" href="/news"><span aria-hidden="true">&larr;</span> All announcements</a>
        <div class="card-meta">
          <span class="badge badge-<%= categoryClass(announcement.category) %>"><%= announcement.category %></span>
          <time datetime="<%= new Date(announcement.published_at).toISOString() %>"><%= formatDate(announcement.published_at) %></time>
        </div>
        <h1><%= announcement.title %></h1>
        <p class="page-lead"><%= announcement.summary %></p>
      </div>
    </section>

    <section class="section article-section">
      <div class="container">
        <% if (announcement.image_url) { %>
          <figure class="article-featured-media">
            <img src="<%= announcement.image_url %>" alt="<%= announcement.title %>" class="article-featured-image">
          </figure>
        <% } %>
        <div class="article-body">
          <p><%= announcement.body %></p>
        </div>
        <% if (announcement.updated_at && formatDateTime(announcement.updated_at) !== formatDateTime(announcement.published_at)) { %>
          <p class="article-updated">Last updated <%= formatDateTime(announcement.updated_at) %></p>
        <% } %>
      </div>
    </section>
  </article>
</main>

<%- include('partials/footer') %>
