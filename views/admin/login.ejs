<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main" class="auth-page">
  <div class="container container-narrow">
    <div class="auth-card">
      <p class="eyebrow">Staff area</p>
      <h1>Administrator sign in</h1>
      <p class="auth-intro">
        Sign in to create, edit and remove university announcements. Public
        pages do not require an account.
      </p>

      <% if (error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
      <% } %>

      <form method="post" action="/admin/login" class="stacked-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>
          <span>Username</span>
          <input type="text" name="username" value="<%= username %>" autocomplete="username" required autofocus>
        </label>
        <label>
          <span>Password</span>
          <input type="password" name="password" autocomplete="current-password" required>
        </label>
        <button class="button button-primary button-full" type="submit">Sign in</button>
      </form>

      <p class="auth-note">
        Credentials are configured on the server through environment variables.
        Unauthorised changes are rejected.
      </p>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
