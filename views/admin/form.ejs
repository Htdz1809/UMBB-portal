<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main">
  <section class="page-hero page-hero-admin">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Staff area</p>
        <h1><%= mode === 'create' ? 'New announcement' : 'Edit announcement' %></h1>
      </div>
      <p class="page-lead">
        <%= mode === 'create'
          ? 'Write a clear title and summary. Published announcements appear on the home page and news page.'
          : 'Update the announcement. Changes are saved to the database when you submit the form.' %>
      </p>
    </div>
  </section>

  <section class="section section-tight section-admin">
    <div class="container container-form">
      <% if (errors.length > 0) { %>
        <div class="alert alert-error" role="alert">
          <strong>Please correct the following:</strong>
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form method="post" action="<%= action %>" enctype="multipart/form-data" class="card form-card">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <label>
          <span>Title</span>
          <input type="text" name="title" value="<%= values.title %>" minlength="3" maxlength="160" required>
          <small>3 to 160 characters.</small>
        </label>

        <label>
          <span>Category</span>
          <select name="category" required>
            <% categories.forEach((category) => { %>
              <option value="<%= category %>" <%= values.category === category ? 'selected' : '' %>><%= category %></option>
            <% }) %>
          </select>
        </label>

        <label>
          <span>Summary</span>
          <textarea name="summary" rows="3" minlength="10" maxlength="300" required><%= values.summary %></textarea>
          <small>Shown in the announcement list. 10 to 300 characters.</small>
        </label>

        <label>
          <span>Full text</span>
          <textarea name="body" rows="10" minlength="10" maxlength="10000" required><%= values.body %></textarea>
          <small>10 to 10,000 characters. Line breaks are preserved.</small>
        </label>

        <div class="form-media-section">
          <label>
            <span>Announcement image (optional)</span>
            <input type="file" name="image" id="image" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml">
            <small>Upload an image from your computer (PNG, JPG, WebP, GIF, SVG up to 8MB).</small>
          </label>

          <% if (values.imageUrl) { %>
            <div class="current-image-box">
              <span class="preview-badge">Current attached image</span>
              <div class="preview-container">
                <img src="<%= values.imageUrl %>" alt="Current announcement image" class="form-image-thumb">
                <div class="preview-controls">
                  <span class="preview-url"><%= values.imageUrl %></span>
                  <label class="checkbox-field remove-image-checkbox">
                    <input type="checkbox" name="remove_image" value="1">
                    <span>Remove current image</span>
                  </label>
                </div>
              </div>
            </div>
          <% } %>

          <label>
            <span>Or enter image URL / path (optional)</span>
            <input type="text" name="image_url" value="<%= values.imageUrl || '' %>" placeholder="e.g. /images/fs.png or https://...">
            <small>Optional image link if you don't upload a file directly.</small>
          </label>
        </div>

        <label class="checkbox-field">
          <input type="checkbox" name="is_published" <%= values.isPublished ? 'checked' : '' %>>
          <span>Published (visible on the public site)</span>
        </label>

        <div class="form-actions">
          <button class="button button-primary" type="submit"><%= mode === 'create' ? 'Create announcement' : 'Save changes' %></button>
          <a class="button button-ghost-dark" href="/admin">Cancel</a>
        </div>
      </form>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
