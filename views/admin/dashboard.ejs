<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main">
  <section class="page-hero page-hero-admin">
    <div class="container">
      <div class="admin-heading">
        <div>
          <p class="eyebrow">Staff area</p>
          <h1>Announcement administration</h1>
          <p class="page-lead">
            Create, edit, publish or remove announcements. Changes are written
            directly to PostgreSQL and appear on the public site immediately.
          </p>
        </div>
        <div class="admin-heading-actions">
          <a class="button button-primary" href="/admin/announcements/new">New announcement</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-admin">
    <div class="container">
      <div class="stats-grid" aria-label="Announcement statistics">
        <div class="stat-card">
          <span>Total</span>
          <strong><%= stats.total %></strong>
        </div>
        <div class="stat-card">
          <span>Published</span>
          <strong><%= stats.published %></strong>
        </div>
        <div class="stat-card">
          <span>Drafts</span>
          <strong><%= stats.drafts %></strong>
        </div>
      </div>

      <% if (announcements.length === 0) { %>
        <div class="empty-state">
          <h2>No announcements yet</h2>
          <p>Create the first announcement to populate the public news page.</p>
          <a class="button button-primary" href="/admin/announcements/new">Create announcement</a>
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table class="admin-table">
            <caption class="visually-hidden">All announcements</caption>
            <thead>
              <tr>
                <th scope="col">Title</th>
                <th scope="col">Category</th>
                <th scope="col">Status</th>
                <th scope="col">Published</th>
                <th scope="col">Updated</th>
                <th scope="col" class="actions-column">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% announcements.forEach((announcement) => { %>
                <tr>
                  <td>
                    <div class="table-title-cell">
                      <% if (announcement.image_url) { %>
                        <img src="<%= announcement.image_url %>" alt="" class="table-row-thumb" loading="lazy">
                      <% } %>
                      <div class="table-title-content">
                        <a class="table-title" href="/news/<%= announcement.id %>"><%= announcement.title %></a>
                        <span class="table-summary"><%= announcement.summary %></span>
                      </div>
                    </div>
                  </td>
                  <td><span class="badge badge-<%= categoryClass(announcement.category) %>"><%= announcement.category %></span></td>
                  <td>
                    <% if (announcement.is_published) { %>
                      <span class="status status-live">Published</span>
                    <% } else { %>
                      <span class="status status-draft">Draft</span>
                    <% } %>
                  </td>
                  <td><%= formatDate(announcement.published_at) %></td>
                  <td><%= formatDateTime(announcement.updated_at) %></td>
                  <td>
                    <div class="row-actions">
                      <a class="button button-small button-secondary" href="/admin/announcements/<%= announcement.id %>/edit">Edit</a>
                      <form method="post" action="/admin/announcements/<%= announcement.id %>/delete" class="inline-form" data-confirm="Delete announcement &quot;<%= announcement.title %>&quot;? This cannot be undone.">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="button button-small button-danger" type="submit">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
