<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-shapes" aria-hidden="true">
      <span class="hero-orb hero-orb-pink"></span>
      <span class="hero-orb hero-orb-blue"></span>
      <span class="hero-ring"></span>
      <span class="hero-cross"></span>
    </div>

    <video class="hero-video" autoplay muted loop playsinline preload="auto" aria-hidden="true" tabindex="-1">
      <source src="/videos/pres.mp4?v=<%= assetVersion %>" type="video/mp4">
    </video>

    <div class="container hero-topline">
      <p class="hero-kicker"><%= university.name %></p>
      <p class="hero-place"><span aria-hidden="true"></span> <%= university.city %></p>
    </div>

    <div class="container hero-headline">
      <h1 class="hero-title" id="home-title">
        <span>Knowledge</span>
        <span>In Motion</span>
      </h1>
    </div>

    <div class="container hero-foot">
      <p class="hero-lead">
        Higher education, research and innovation since 1998. Discover six
        faculties, two institutes and a community shaping the future of the
        Boumerdès region.
      </p>
      <div class="hero-actions">
        <a class="pill-button pill-button-yellow" href="/departments">Explore academics</a>
        <a class="pill-button pill-button-ghost" href="/news">Latest news</a>
      </div>
    </div>
  </section>

  <section class="promo-section" aria-label="Explore UMBB">
    <div class="promo-grid">
      <article class="promo-card theme-yellow">
        <p class="promo-eyebrow">Future students</p>
        <div class="promo-body">
          <h2 class="promo-title">Find your place at UMBB</h2>
          <p class="promo-desc">
            Explore <%= stats.departments %> academic units spanning science,
            engineering, economics, law, languages and the arts of teaching.
          </p>
        </div>
        <div class="promo-footer">
          <a class="pill-link" href="/departments">Explore academics</a>
        </div>
      </article>

      <article class="promo-card theme-white">
        <p class="promo-eyebrow">Quick access</p>
        <nav class="promo-links" aria-label="Quick links">
          <a href="/departments">Faculties &amp; institutes <span aria-hidden="true">&nearr;</span></a>
          <a href="/news">News &amp; announcements <span aria-hidden="true">&nearr;</span></a>
          <a href="/#about">About the university <span aria-hidden="true">&nearr;</span></a>
        </nav>
        <div class="promo-footer">
          <p class="promo-desc">
            A public university created in 1998, serving students and the
            economic and social life of Boumerdès.
          </p>
        </div>
      </article>

      <article class="promo-card theme-pink">
        <div class="promo-art" aria-hidden="true"></div>
        <p class="promo-eyebrow">About UMBB</p>
        <div class="promo-body">
          <h2 class="promo-title">Six faculties. Two institutes.</h2>
          <p class="promo-desc">
            One community bringing together teaching, research and public
            service across the Boumerdès region.
          </p>
        </div>
        <div class="promo-footer">
          <a class="pill-link" href="/#about">Discover our story</a>
        </div>
      </article>

      <article class="promo-card theme-blue">
        <p class="promo-eyebrow">Newsroom</p>
        <div class="promo-body">
          <h2 class="promo-title">Latest from campus</h2>
          <p class="promo-desc">
            Academic notices, events and stories from across our faculties and
            institutes.
          </p>
        </div>
        <div class="promo-footer">
          <a class="pill-link" href="/news">Read announcements</a>
        </div>
      </article>

      <article class="promo-card theme-green promo-card-media">
        <div class="promo-media-art" aria-hidden="true"></div>
        <p class="promo-eyebrow">Campus &amp; Sites</p>
        <div class="promo-body">
          <h2 class="promo-title">Faculties Localization</h2>
          <div class="campus-locations-list">
            <div class="campus-loc-item">
              <strong>Campus Ouest / Centre:</strong>
              <span>Sciences (FS) · Hydrocarbures &amp; Chimie (FHC) · Technologie (FT)</span>
            </div>
            <div class="campus-loc-item">
              <strong>Campus Est:</strong>
              <span>Génie Électrique &amp; Électronique (IGEE / ex-INELEC)</span>
            </div>
            <div class="campus-loc-item">
              <strong>Pôle Sahel:</strong>
              <span>Sciences Économiques &amp; Gestion (FSG) · Droit (FDSP)</span>
            </div>
            <div class="campus-loc-item">
              <strong>Pôle Ville &amp; Bordj Ménaïel:</strong>
              <span>Lettres &amp; Langues (FLL) · ISTA</span>
            </div>
          </div>
        </div>
        <div class="promo-footer">
          <a class="pill-link" href="https://maps.google.com/?q=Universite+M'Hamed+Bougara+Boumerdes" target="_blank" rel="noopener noreferrer">View on Map &nearr;</a>
        </div>
      </article>

      <article class="promo-card theme-yellow">
        <p class="promo-eyebrow">Research &amp; Innovation</p>
        <div class="promo-body">
          <h2 class="promo-title">Scientific research</h2>
          <p class="promo-desc">
            Laboratories and research teams contributing to engineering,
            hydrocarbons, chemistry and applied sciences.
          </p>
        </div>
        <div class="promo-footer">
          <a class="pill-link" href="/departments">Explore faculties</a>
        </div>
      </article>
    </div>
  </section>

  <section class="home-news" id="news">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Latest updates</p>
          <h2>Recent announcements</h2>
        </div>
        <div class="section-heading-aside">
          <p>
            Notices, events and stories published by the university. Visit the
            newsroom for the full archive.
          </p>
          <a class="text-link" href="/news">All announcements <span aria-hidden="true">&nearr;</span></a>
        </div>
      </div>

      <% if (recentAnnouncements.length === 0) { %>
        <div class="empty-state">
          <h3>No announcements yet</h3>
          <p>Published news and announcements will appear here.</p>
        </div>
      <% } else { %>
        <div class="story-grid">
          <% recentAnnouncements.forEach((announcement) => { %>
            <article class="story-card <%= announcement.image_url ? 'has-card-image' : '' %>">
              <% if (announcement.image_url) { %>
                <div class="story-cover">
                  <img src="<%= announcement.image_url %>" alt="" class="story-cover-image" loading="lazy">
                </div>
              <% } %>
              <div class="story-meta">
                <span class="badge badge-<%= categoryClass(announcement.category) %>"><%= announcement.category %></span>
                <time datetime="<%= new Date(announcement.published_at).toISOString() %>"><%= formatDate(announcement.published_at) %></time>
              </div>
              <h3><a href="/news/<%= announcement.id %>"><%= announcement.title %></a></h3>
              <p><%= announcement.summary %></p>
              <a class="story-link" href="/news/<%= announcement.id %>">Read story <span aria-hidden="true">&nearr;</span></a>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <section class="home-about" id="about">
    <div class="container about-grid">
      <div class="about-statement">
        <p class="eyebrow">About the university</p>
        <h2>Teaching, research and public service.</h2>
      </div>
      <div class="about-copy">
        <p class="about-lead"><%= university.tagline %></p>
        <p>
          UMBB was created in 1998 by Executive Decree 98-189. Its academic
          units cover science and technology, hydrocarbons and chemistry,
          economics and management, law and political science, languages,
          electrical engineering and applied sciences.
        </p>
        <a class="text-link" href="/departments">Discover our academic units <span aria-hidden="true">&nearr;</span></a>
      </div>
    </div>

    <div class="container stat-strip" aria-label="University at a glance">
      <div class="stat-block">
        <strong><%= stats.departments %></strong>
        <span>Faculties and institutes</span>
      </div>
      <div class="stat-block">
        <strong><%= stats.announcements %></strong>
        <span>Published announcements</span>
      </div>
      <div class="stat-block">
        <strong><%= new Date().getFullYear() - university.founded %></strong>
        <span>Years of higher education</span>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
