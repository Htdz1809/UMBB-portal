<a class="skip-link" href="#main">Skip to main content</a>

<header class="site-header">
  <div class="header-shell">
    <a class="brand" href="/" aria-label="<%= university.name %> home">
      <img class="brand-mark" src="/images/umbb-logo.png?v=<%= assetVersion %>" alt="" width="46" height="46">
      <span class="brand-text">
        <strong>UMBB</strong>
        <small>Boumerdès</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>" <%= currentPath === '/' ? 'aria-current="page"' : '' %>>Home</a>
      <a href="/departments" class="<%= currentPath === '/departments' ? 'active' : '' %>" <%= currentPath === '/departments' ? 'aria-current="page"' : '' %>>Academics</a>
      <a href="/news" class="<%= currentPath.startsWith('/news') ? 'active' : '' %>" <%= currentPath.startsWith('/news') ? 'aria-current="page"' : '' %>>News &amp; events</a>
      <a href="/#about">About</a>
    </nav>

    <div class="header-actions">
      <% if (currentUser) { %>
        <% if (currentPath.startsWith('/admin')) { %>
          <a href="/" class="header-staff">View website &nearr;</a>
        <% } else { %>
          <a href="/admin" class="header-staff is-active">Admin panel</a>
        <% } %>
        <form action="/admin/logout" method="post" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="header-staff">Sign out</button>
        </form>
      <% } %>
    </div>
  </div>
</header>

<% if (flash) { %>
  <div class="container flash-container">
    <div class="flash flash-<%= flash.type %>" role="status">
      <span class="flash-icon" aria-hidden="true">
        <% if (flash.type === 'success') { %>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
        <% } else if (flash.type === 'error') { %>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
        <% } else { %>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
        <% } %>
      </span>
      <span class="flash-text"><%= flash.message %></span>
      <button type="button" class="flash-close" onclick="this.closest('.flash-container').remove()" aria-label="Dismiss notification">&times;</button>
    </div>
  </div>
<% } %>
