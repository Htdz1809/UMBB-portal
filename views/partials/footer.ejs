<footer class="site-footer" id="contact">
  <div class="container footer-grid">
    <div>
      <a class="brand brand-footer" href="/">
        <img class="brand-mark" src="/images/umbb-logo.png?v=<%= assetVersion %>" alt="" width="40" height="40">
        <span class="brand-text">
          <strong>UMBB</strong>
          <small>Boumerdès</small>
        </span>
      </a>
      <p class="footer-about"><%= university.about %></p>
    </div>

    <div>
      <h2>Contact</h2>
      <address>
        <%= university.address %><br>
        <a href="mailto:<%= university.email %>"><%= university.email %></a><br>
        <a href="tel:<%= university.phone.replace(/[^+\d]/g, '') %>"><%= university.phone %></a>
      </address>
    </div>

    <div>
      <h2>Explore</h2>
      <ul class="footer-links">
        <li><a href="/departments">Faculties and institutes</a></li>
        <li><a href="/news">News and announcements</a></li>
        <li><a href="/#about">About UMBB</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; <%= new Date().getFullYear() %> <%= university.name %></p>
    <p>Academic demonstration portal; not an official university website.</p>
  </div>
</footer>
</body>
</html>
