<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Stay informed</p>
        <h1>News and announcements</h1>
      </div>
      <p class="page-lead">
        Updates from UMBB, including academic notices, events and research
        stories from across its faculties and institutes.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <form class="filter-bar" method="get" action="/news" aria-label="Filter announcements">
        <label>
          <span>Category</span>
          <select name="category">
            <option value="">All categories</option>
            <% categories.forEach((category) => { %>
              <option value="<%= category %>" <%= selectedCategory === category ? 'selected' : '' %>><%= category %></option>
            <% }) %>
          </select>
        </label>
        <label class="filter-search">
          <span>Search</span>
          <input type="search" name="q" value="<%= searchQuery %>" placeholder="Search announcements" maxlength="100">
        </label>
        <button class="button button-secondary" type="submit">Filter</button>
        <% if (selectedCategory || searchQuery) { %>
          <a class="text-link" href="/news">Clear filters</a>
        <% } %>
      </form>

      <% if (announcements.length === 0) { %>
        <div class="empty-state">
          <h2>No matching announcements</h2>
          <p>Try a different category or search term, or <a href="/news">view all announcements</a>.</p>
        </div>
      <% } else { %>
        <p class="result-count"><%= announcements.length %> announcement<%= announcements.length === 1 ? '' : 's' %></p>
        <div class="announcement-list">
          <% announcements.forEach((announcement, index) => { %>
            <article class="announcement-row">
              <div class="announcement-row-meta">
                <span class="announcement-index" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
                <span class="badge badge-<%= categoryClass(announcement.category) %>"><%= announcement.category %></span>
                <time datetime="<%= new Date(announcement.published_at).toISOString() %>"><%= formatDate(announcement.published_at) %></time>
              </div>
              <div class="announcement-main">
                <% if (announcement.image_url) { %>
                  <div class="announcement-thumb-wrap">
                    <img src="<%= announcement.image_url %>" alt="" class="announcement-thumb" loading="lazy">
                  </div>
                <% } %>
                <div class="announcement-copy">
                  <h2><a href="/news/<%= announcement.id %>"><%= announcement.title %></a></h2>
                  <p><%= announcement.summary %></p>
                </div>
              </div>
              <a class="text-link" href="/news/<%= announcement.id %>" aria-label="Read <%= announcement.title %>">Read <span aria-hidden="true">&nearr;</span></a>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
