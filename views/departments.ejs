<%
  const facultyLogoMap = {
    // English names
    'Faculty of Sciences': '/images/fs.png',
    'Faculty of Technology': '/images/ft.png',
    'Faculty of Hydrocarbons and Chemistry': '/images/fhc.png',
    'Faculty of Economic, Commercial and Management Sciences': '/images/fsecsg.png',
    'Faculty of Economics, Commercial and Management Sciences': '/images/fsecsg.png',
    'Faculty of Law and Political Science': '/images/fdsp.png',
    'Faculty of Letters and Languages': '/images/fll.png',
    'Institute of Electrical and Electronic Engineering': '/images/igee.png',
    'Institute of Applied Science and Technology': '/images/ista.png',
    'Institute of Applied Sciences and Technology': '/images/ista.png',

    // French fallback
    'Faculté des Sciences': '/images/fs.png',
    'Faculté de Technologie': '/images/ft.png',
    'Faculté des Hydrocarbures et de la Chimie': '/images/fhc.png',
    'Faculté des Sciences Economiques, Commerciales et des Sciences de Gestion': '/images/fsecsg.png',
    'Faculté de Droit et des Sciences Politiques': '/images/fdsp.png',
    'Faculté des Lettres et des Langues': '/images/fll.png',
    'Institut de Génie Electrique et Electronique': '/images/igee.png',
    'Institut des Sciences et Techniques Appliquées': '/images/ista.png',
  };
%>

<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Academic units</p>
        <h1>Our faculties and institutes</h1>
      </div>
      <p class="page-lead">
        UMBB's academic units combine teaching, research and community
        activities. Contact the faculty or institute office for programme and
        admissions questions.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <% if (departments.length === 0) { %>
        <div class="empty-state">
          <h2>No academic units available</h2>
          <p>Faculty and institute information will appear here once it is added.</p>
        </div>
      <% } else { %>
        <div class="card-grid department-grid">
          <% departments.forEach((department, index) => { %>
            <% const isInstitute = department.name.toLowerCase().includes('institut') || department.name.toLowerCase().includes('institute'); %>
            <% const unitType = isInstitute ? 'Institute' : 'Faculty'; %>
            <%
              let logoSrc = facultyLogoMap[department.name];
              if (!logoSrc) {
                const lower = department.name.toLowerCase();
                if (lower.includes('hydrocarbon') || lower.includes('chimie')) logoSrc = '/images/fhc.png';
                else if (lower.includes('technolog')) logoSrc = '/images/ft.png';
                else if (lower.includes('econom') || lower.includes('gestion')) logoSrc = '/images/fsecsg.png';
                else if (lower.includes('droit') || lower.includes('law')) logoSrc = '/images/fdsp.png';
                else if (lower.includes('lettre') || lower.includes('letter') || lower.includes('language')) logoSrc = '/images/fll.png';
                else if (lower.includes('electr') || lower.includes('igee') || lower.includes('inelec')) logoSrc = '/images/igee.png';
                else if (lower.includes('appliqu') || lower.includes('applied') || lower.includes('ista')) logoSrc = '/images/ista.png';
                else if (lower.includes('science')) logoSrc = '/images/fs.png';
              }
            %>
            <article class="card department-card">
              <div class="card-topline">
                <% if (logoSrc) { %>
                  <div class="department-emblem">
                    <img src="<%= logoSrc %>?v=<%= assetVersion %>" alt="<%= department.name %> logo" class="department-logo" loading="lazy">
                  </div>
                <% } %>
                <div class="department-meta">
                  <span class="department-mark" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
                  <span class="card-label"><%= unitType %></span>
                </div>
              </div>
              <h2><%= department.name %></h2>
              <p><%= department.description %></p>
              <dl class="detail-list">
                <div>
                  <dt>Dean / Director</dt>
                  <dd><%= department.head_of_department %></dd>
                </div>
                <div>
                  <dt>Contact</dt>
                  <dd><a href="mailto:<%= department.contact_email %>"><%= department.contact_email %></a></dd>
                </div>
              </dl>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>